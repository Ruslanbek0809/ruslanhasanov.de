---
interface Props {
  heading: string;
  /** id of the h2, referenced by the section's aria-labelledby. */
  id: string;
  /** Keep the heading for screen readers and the outline, but do not show it. */
  hidden?: boolean;
}

const { heading, id, hidden = false } = Astro.props;
---

<h2 id={id} class:list={{ 'visually-hidden': hidden }}>{heading}</h2>
