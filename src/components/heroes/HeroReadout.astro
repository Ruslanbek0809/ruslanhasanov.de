---
/** Hero 2 "Readout": no photo in the hero; facts and key figures on the right. The photo moves to About. */
import { home } from '../../data';
import type { Locale } from '../../i18n/routes';
import { ui } from '../../i18n/ui';
import FactsCard from './FactsCard.astro';
import HeroActions from './HeroActions.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { hero, highlights } = home[locale];
---

<section class="hero grid-paper" aria-labelledby="hero-name">
  <div class="wrap layout stack">
    <div class="lead flat">
      <div class="intro o1">
        <p class="status">{hero.availability}</p>
        <h1 id="hero-name">{hero.name}</h1>
        <p class="role">{hero.role}</p>
      </div>
      <p class="pitch o3">{hero.pitch}</p>
      <HeroActions locale={locale} class="o4" />
    </div>
    <div class="side flat">
      <FactsCard locale={locale} class="o2" />
      <dl class="readout o5" aria-label={ui[locale].keyFigures}>
        {
          highlights.items.map((item) => (
            <div>
              <dt>{item.caption}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  /* Desktop grid; below 761px the shared .stack rules in global.css reorder the parts. */
  @media (min-width: 761px) {
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      gap: clamp(2rem, 5vw, 4.5rem);
      align-items: stretch;
    }
    .lead {
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
      justify-content: center;
    }
    .side {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
  }
  .intro h1 {
    font-size: clamp(2.5rem, 7.5vw, 5rem);
  }
  .readout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin: 0;
  }
  .readout div {
    background: var(--surface);
    padding: 0.75rem 1rem 0.85rem;
    min-width: 0;
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }
  .readout dd {
    margin: 0;
    font: 500 clamp(1.5rem, 2.6vw, 1.875rem)/1.1 var(--mono);
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .readout dt {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--muted);
    margin-top: 0.35rem;
  }
  @media (max-width: 760px) {
    .side {
      gap: 1.25rem;
    }
    .readout dd {
      font-size: 1.375rem;
    }
  }
</style>
