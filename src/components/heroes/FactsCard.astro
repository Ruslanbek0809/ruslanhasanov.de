---
import { site } from '../../config/site';
import { home } from '../../data';
import type { Locale } from '../../i18n/routes';
import ExternalLink from '../ExternalLink.astro';

interface Props {
  locale: Locale;
  /** Profile links under the facts (Hero 1). */
  framed?: boolean;
  class?: string;
}

const { locale, framed = false, class: className } = Astro.props;
const { facts } = home[locale].hero;
---

<aside class:list={['facts', className]} aria-label={facts.heading}>
  <dl class="kv">
    <div>
      <dt>{facts.status.label}</dt>
      <dd><span class="hl">{facts.status.value}</span> · {facts.status.detail}</dd>
    </div>
    <div>
      <dt>{facts.location.label}</dt>
      <dd>{facts.location.value}</dd>
    </div>
    <div>
      <dt>{facts.thesis.label}</dt>
      <dd>{facts.thesis.value}</dd>
    </div>
    <div>
      <dt>{facts.funding.label}</dt>
      <dd>{facts.funding.value}</dd>
    </div>
  </dl>
  {
    framed && (
      <div class="facts-foot">
        <ExternalLink href={site.github} locale={locale}>github</ExternalLink>
        <ExternalLink href={site.linkedin} locale={locale}>linkedin</ExternalLink>
        <a href={`mailto:${site.email}`}>email</a>
      </div>
    )
  }
</aside>

<style>
  .kv {
    margin: 0;
    font-size: 0.9375rem;
  }
  .kv div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
  }
  .kv div:first-child {
    padding-top: 0;
  }
  .kv dt {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted);
    hyphens: auto;
  }
  .kv dd {
    margin: 0;
    line-height: 1.55;
    color: var(--ink);
  }
  .hl {
    color: var(--accent);
    font-weight: 600;
  }
  .facts-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    padding-top: 0.9rem;
    font: 600 0.875rem var(--sans);
  }
  .facts-foot :global(a) {
    color: var(--ink);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .facts-foot :global(a:hover) {
    color: var(--accent);
    text-decoration: underline;
  }
  .facts-foot :global(svg) {
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .kv div {
      grid-template-columns: 6rem minmax(0, 1fr);
      gap: 0.75rem;
      padding: 0.55rem 0;
    }
    .kv div:first-child {
      padding-top: 0.55rem;
      border-top: 1px solid var(--line);
    }
  }
</style>
