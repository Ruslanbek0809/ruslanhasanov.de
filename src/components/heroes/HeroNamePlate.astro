---
/** Hero 1 "Name plate": small greyscale photo set with the name; key facts on the right. */
import { home } from '../../data';
import type { Locale } from '../../i18n/routes';
import Photo from '../Photo.astro';
import FactsCard from './FactsCard.astro';
import HeroActions from './HeroActions.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { hero } = home[locale];
---

<section class="hero" aria-labelledby="hero-name">
  <div class="wrap layout stack">
    <div class="lead flat">
      <div class="o1">
        <p class="status">{hero.availability}</p>
        <div class="plate">
          <Photo locale={locale} class="plate-photo" sizes="(max-width: 760px) 80px, 120px" />
          <div>
            <h1 id="hero-name">{hero.name}</h1>
            <p class="role">{hero.role}</p>
          </div>
        </div>
      </div>
      <p class="pitch o3">{hero.pitch}</p>
      <HeroActions locale={locale} class="o4" />
    </div>
    <FactsCard locale={locale} framed class="o2" />
  </div>
</section>

<style>
  /* Desktop grid; below 761px the shared .stack rules in global.css reorder the parts. */
  @media (min-width: 761px) {
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
      gap: clamp(2.5rem, 6vw, 6rem);
      align-items: end;
    }
    .lead {
      display: grid;
      gap: 2rem;
    }
  }
  .plate {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }
  .plate :global(.plate-photo) {
    width: clamp(5rem, 9vw, 7.5rem);
    height: clamp(5rem, 9vw, 7.5rem);
  }
  @media (max-width: 760px) {
    .plate {
      align-items: center;
    }
    .plate h1 {
      font-size: clamp(2rem, 9.5vw, 2.5rem);
      margin-bottom: 0.4rem;
    }
    .plate .role {
      font-size: 0.875rem;
    }
    .status {
      margin-bottom: 1rem;
    }
  }
</style>
