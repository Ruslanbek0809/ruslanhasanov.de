---
/** Hero 3 "Spec strip": tight head-and-shoulders crop as the first cell of a full-width facts strip. */
import { home } from '../../data';
import type { Locale } from '../../i18n/routes';
import Photo from '../Photo.astro';
import HeroActions from './HeroActions.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { hero } = home[locale];
const f = hero.facts;
const cells = [
  { cls: 'c-loc', label: f.location.label, value: f.location.stripValue, detail: f.location.stripDetail },
  { cls: 'c-avail', label: f.status.stripLabel, value: f.status.stripValue, detail: f.status.stripDetail },
  { cls: 'c-thesis', label: f.thesis.label, value: f.thesis.stripValue, detail: f.thesis.stripDetail },
  { cls: 'c-fund', label: f.funding.label, value: f.funding.stripValue, detail: f.funding.stripDetail },
];
---

<section class="hero" aria-labelledby="hero-name">
  <div class="wrap layout stack">
    <div class="intro o1">
      <p class="status">{hero.availability}</p>
      <h1 id="hero-name">{hero.name}</h1>
      <p class="role">{hero.role}</p>
    </div>
    <p class="pitch o3">{hero.pitch}</p>
    <HeroActions locale={locale} class="o4 strip-actions" />
    <div class="strip o2" role="group" aria-label={f.heading}>
      <Photo locale={locale} class="strip-photo" sizes="(max-width: 760px) 104px, 136px" />
      <dl class="cells">
        {
          cells.map((c) => (
            <div class:list={['cell', c.cls]}>
              <dt>
                {c.label}
              </dt>
              <dd>
                <strong>{c.value}</strong>
                <small>{c.detail}</small>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  /* Desktop grid; below 761px the shared .stack rules in global.css reorder the parts. */
  @media (min-width: 761px) {
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1.75rem 3rem;
      align-items: end;
    }
  }
  .intro {
    grid-column: 1 / -1;
  }
  .intro h1 {
    font-size: clamp(2.5rem, 8vw, 5.5rem);
  }
  .strip {
    grid-column: 1 / -1;
    margin: 0.75rem 0 0;
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) minmax(0, 1.9fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .cells {
    display: contents;
  }
  .strip :global(.strip-photo),
  .cell {
    background: var(--surface);
    min-width: 0;
  }
  .strip :global(.strip-photo) {
    border: 0;
    padding: 0;
    height: 100%;
    min-height: 8.5rem;
  }
  .strip :global(.strip-photo img) {
    aspect-ratio: auto;
  }
  .cell {
    padding: 0.85rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  dt {
    font: 400 0.8125rem/1.4 var(--sans);
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  dd strong {
    display: block;
    font: 600 1.0625rem/1.3 var(--sans);
    margin-bottom: 0.15rem;
  }
  dd small {
    color: var(--muted);
    font-size: 0.8125rem;
    display: block;
  }
  @media (max-width: 1000px) {
    .strip {
      grid-template-columns: 8rem repeat(2, minmax(0, 1fr));
    }
    .strip :global(.strip-photo) {
      grid-row: span 2;
    }
  }
  @media (max-width: 760px) {
    :global(.strip-actions) {
      margin-top: -0.25rem;
    }
    .strip {
      margin: 0;
      grid-template-columns: 6.5rem minmax(0, 1fr);
    }
    .strip :global(.strip-photo) {
      grid-row: 1 / span 2;
      grid-column: 1;
      min-height: 0;
    }
    .c-loc {
      grid-row: 1;
      grid-column: 2;
    }
    .c-thesis {
      grid-row: 2;
      grid-column: 2;
    }
    .c-avail,
    .c-fund {
      grid-column: 1 / -1;
    }
    .cell {
      padding: 0.6rem 0.8rem 0.7rem;
      gap: 0.2rem;
    }
    dd strong {
      font-size: 0.9375rem;
    }
  }
</style>
