---
import { render } from 'astro:content';
import { homeAnchor, workAlternates, workPath, type Locale } from '../i18n/routes';
import { ui } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projectSlug, type Project } from '../lib/projects';
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  entry: Project;
  next: Project;
  index: number;
  total: number;
}

const { locale, entry, next } = Astro.props;
const { data } = entry;
const t = ui[locale].caseStudy;
const slug = projectSlug(entry);
const { Content } = await render(entry);
---

<BaseLayout
  locale={locale}
  title={`${data.title} | Ruslan Hasanov`}
  description={data.description}
  alternates={workAlternates(slug)}
  ogType="article"
>
  <article aria-labelledby="cs-title">
    <header class="cs-head">
      <div class="wrap">
        <a class="back" href={homeAnchor('work', locale)}>
          <Icon name="arrow-left" />
          {t.back}
        </a>
        <div class="kicker">
          <p class="eyebrow">{t.eyebrow}</p>
          <span class:list={['chip', `chip--${data.badge.tone}`]}>{data.badge.label}</span>
        </div>
        <h1 id="cs-title">{data.title}</h1>
        <p class="tagline">{data.tagline}</p>
        <dl class="meta">
          <div>
            <dt>{t.period}</dt>
            <dd>{data.period}</dd>
          </div>
          <div>
            <dt>{t.context}</dt>
            <dd>{data.context}</dd>
          </div>
        </dl>
      </div>
    </header>

    <div class="wrap cs-body">
      <div class="prose">
        <Content />
      </div>

      <aside class="side">
        {
          data.figures.length > 0 && (
            <dl class="figs">
              {data.figures.map((fig) => (
                <div>
                  <dt>{fig.label}</dt>
                  <dd>{fig.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
        <div class="panel">
          <h2 class="panel-head">{t.stack}</h2>
          <ul class="tags">
            {data.stack.map((s) => <li>{s}</li>)}
          </ul>
        </div>
        <div class="panel">
          <h2 class="panel-head">{t.links}</h2>
          {
            data.links.length > 0 ? (
              <ul class="links">
                {data.links.map((link) => (
                  <li>
                    <ExternalLink href={link.href} locale={locale}>
                      {link.label}
                    </ExternalLink>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="none">{t.noLinks}</p>
            )
          }
        </div>
      </aside>

      <section class="highlight" aria-labelledby="cs-highlight">
        <h2 id="cs-highlight" class="eyebrow">{t.highlight}</h2>
        <p>{data.highlight}</p>
      </section>
    </div>

    <nav class="wrap" aria-label={t.next}>
      <div class="pager">
      <a class="pager-back" href={homeAnchor('work', locale)}>
        <Icon name="arrow-left" />
        {t.back}
      </a>
      <a class="pager-next" href={workPath(projectSlug(next), locale)}>
        <span class="eyebrow">{t.next}</span>
        <span class="next-title">
          {next.data.title}
          <Icon name="arrow-right" />
        </span>
      </a>
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  .cs-head .wrap {
    padding-top: clamp(1.75rem, 4vw, 2.75rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font: 600 0.9375rem var(--sans);
    color: var(--muted);
    text-decoration: none;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .back:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    margin-bottom: 1rem;
    font-size: 0.9375rem;
  }
  .kicker .eyebrow {
    margin: 0;
    font-size: inherit;
    color: var(--accent);
  }
  .kicker .eyebrow::first-letter {
    text-transform: uppercase;
  }
  .kicker .eyebrow::after {
    content: '·';
    margin-left: 0.6rem;
    color: var(--muted);
  }
  h1 {
    font: 700 clamp(2rem, 5vw, 3.5rem)/1.06 var(--sans);
    letter-spacing: -0.04em;
    margin: 0 0 1.25rem;
    max-width: 54rem;
  }
  .tagline {
    font: 500 clamp(1.125rem, 2.1vw, 1.375rem)/1.45 var(--sans);
    letter-spacing: -0.01em;
    color: var(--ink-2);
    max-width: 42rem;
    margin: 0 0 2.25rem;
  }
  .meta {
    margin: 0;
    max-width: 54rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem clamp(2rem, 5vw, 4rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
  }
  .meta div {
    min-width: 0;
  }
  .meta dt {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .meta dd {
    margin: 0;
    color: var(--ink);
  }

  .cs-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 19rem);
    gap: 2.5rem clamp(2.5rem, 6vw, 6rem);
    padding-top: clamp(1rem, 3vw, 2rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
    align-items: start;
  }
  .side {
    display: grid;
    gap: 2rem;
    grid-row: span 2;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) * 1.5);
    background: var(--surface);
  }
  .figs {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1rem;
  }
  .figs div {
    min-width: 0;
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.25rem;
  }
  .figs dt {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--muted);
  }
  .figs dd {
    margin: 0;
    font: 700 1.375rem/1.1 var(--sans);
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .panel-head {
    font: 600 0.9375rem var(--sans);
    letter-spacing: 0;
    margin: 0 0 0.5rem;
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .links :global(a) {
    font: 600 0.9375rem var(--sans);
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .links :global(a:hover) {
    text-decoration: underline;
  }
  .none {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .highlight {
    max-width: 42rem;
    border-radius: var(--radius);
    background: var(--tint);
    padding: 1.25rem 1.5rem;
  }
  .highlight .eyebrow {
    color: var(--accent);
  }
  .highlight p {
    margin: 0;
    font: 500 1.125rem/1.55 var(--sans);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.25rem 2rem;
    padding: 2rem 0 clamp(3rem, 7vw, 5rem);
    border-top: 1px solid var(--line);
  }
  .pager a {
    text-decoration: none;
  }
  .pager-back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font: 600 0.9375rem var(--sans);
    color: var(--muted);
  }
  .pager-back:hover {
    color: var(--ink);
  }
  .pager-next {
    display: flex;
    flex-direction: column;
    max-width: 32rem;
    margin-left: auto;
    text-align: right;
  }
  .pager-next .eyebrow {
    color: var(--muted);
    font-weight: 400;
    margin-bottom: 0.25rem;
  }
  .next-title {
    font: 600 clamp(1.125rem, 2vw, 1.375rem)/1.3 var(--sans);
    letter-spacing: -0.02em;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .next-title :global(svg) {
    color: var(--accent);
  }
  .pager-back:hover,
  .pager-next:hover .next-title {
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .cs-body {
      grid-template-columns: 1fr;
    }
    .side {
      grid-row: auto;
      order: 2;
    }
    .highlight {
      order: 1;
    }
  }
  @media (max-width: 560px) {
    .pager-next {
      text-align: left;
      margin-left: 0;
      width: 100%;
    }
    .next-title {
      justify-content: flex-start;
    }
  }
</style>
