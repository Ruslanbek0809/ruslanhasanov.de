---
import { getCollection, render } from 'astro:content';
import { pageAlternates, type Locale } from '../i18n/routes';
import { ui } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
  page: 'imprint' | 'privacy';
}

const { locale, page } = Astro.props;
const [entry] = await getCollection('legal', (e) => e.id.startsWith(`${locale}/`) && e.data.page === page);
if (!entry) throw new Error(`Missing legal page "${page}" for locale "${locale}" in src/content/legal/`);

const { Content } = await render(entry);
const t = ui[locale].legal;
---

<BaseLayout
  locale={locale}
  title={`${entry.data.title} | Ruslan Hasanov`}
  description={entry.data.description}
  alternates={pageAlternates(page)}
  noindex
>
  <div class="wrap legal">
    <h1>{entry.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
    <p class="updated">{t.updated}: {entry.data.updated}</p>
  </div>
</BaseLayout>

<style>
  .legal {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }
  h1 {
    font: 700 clamp(2.25rem, 5.5vw, 3.5rem)/1.06 var(--sans);
    letter-spacing: -0.04em;
    margin: 0 0 2.25rem;
  }
  .updated {
    font-size: 0.875rem;
    color: var(--muted);
    margin: 3rem 0 0;
  }
</style>
