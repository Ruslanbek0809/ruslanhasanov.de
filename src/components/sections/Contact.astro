---
import { site } from '../../config/site';
import { home } from '../../data';
import type { Locale } from '../../i18n/routes';
import { ui } from '../../i18n/ui';
import { allCvs } from '../../lib/cv';
import ExternalLink from '../ExternalLink.astro';
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { contact } = home[locale];
const t = ui[locale];
const cvs = allCvs();
---

<section class="block contact-block" id="contact" aria-labelledby="h-contact">
  <div class="wrap">
    <div class="contact">
      <SectionHead heading={contact.heading} id="h-contact" />
      <p>{contact.invitation}</p>
      {contact.note && <p class="note">{contact.note}</p>}
      <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
      <div class="actions">
        <ExternalLink class="btn" href={site.github} locale={locale} icon={false}>
          <Icon name="github" />
          GitHub
        </ExternalLink>
        <ExternalLink class="btn" href={site.linkedin} locale={locale} icon={false}>
          <Icon name="linkedin" />
          LinkedIn
        </ExternalLink>
        {
          cvs.map((cv) => (
            <a class="btn" href={cv.href} download hreflang={cv.lang}>
              <Icon name="download" />
              {t.cvLabels[cv.lang]}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .contact-block {
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }
  .contact :global(h2) {
    font-size: clamp(2rem, 4.6vw, 3.25rem);
    margin-bottom: 1.25rem;
  }
  .contact p {
    font-size: clamp(1.0625rem, 1.8vw, 1.25rem);
    max-width: 38rem;
    margin: 0 0 1.75rem;
  }
  .contact .note {
    font-size: 0.9375rem;
    color: var(--muted);
    margin-top: -1rem;
  }
  .mail {
    display: inline-block;
    font: 700 clamp(1.25rem, 4.4vw, 2.5rem)/1.2 var(--sans);
    letter-spacing: -0.03em;
    color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
    overflow-wrap: anywhere;
    margin-bottom: 2rem;
  }
  .mail:hover {
    text-decoration-thickness: 3px;
  }
</style>
