---
import { showPhotoInAbout } from '../../config/site';
import { home } from '../../data';
import type { Locale } from '../../i18n/routes';
import Photo from '../Photo.astro';
import SectionHead from '../SectionHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { about } = home[locale];
---

<section class="block" id="about" aria-labelledby="h-about">
  <div class="wrap">
    {
      showPhotoInAbout ? (
        <div class="head-row">
          <Photo locale={locale} class="about-photo" sizes="(max-width: 760px) 88px, 152px" loading="lazy" />
          <div>
            <SectionHead heading={about.heading} id="h-about" />
          </div>
        </div>
      ) : (
        <SectionHead heading={about.heading} id="h-about" />
      )
    }
    <div class="about">
      <div class="text">
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <div class="now">
        <p class="now-label">{about.now.label}</p>
        {about.now.text.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .head-row {
    display: flex;
    align-items: flex-end;
    gap: 1.25rem 2rem;
    margin-bottom: 2rem;
  }
  .head-row :global(.about-photo) {
    width: 8rem;
    height: 8rem;
  }
  .head-row :global(h2) {
    margin-bottom: 0;
  }
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .text p {
    margin: 0 0 1.25rem;
    font-size: clamp(1.125rem, 1.8vw, 1.3125rem);
    line-height: 1.65;
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 40rem;
  }
  .text p:last-child {
    margin-bottom: 0;
  }
  .now {
    padding-top: 0.5rem;
  }
  .now-label {
    font-weight: 600;
    color: var(--accent);
  }
  .now p {
    font-size: 0.9375rem;
    margin: 0;
  }
  .now p + p {
    margin-top: 0.5rem;
  }
  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
    }
    .now {
      padding-top: 1.25rem;
      border-top: 1px solid var(--line);
    }
    .head-row {
      align-items: center;
    }
    .head-row :global(.about-photo) {
      width: 5rem;
      height: 5rem;
    }
  }
</style>
