---
import { home } from '../../data';
import { workPath, type Locale } from '../../i18n/routes';
import { ui } from '../../i18n/ui';
import { getProjects, projectSlug } from '../../lib/projects';
import ExternalLink from '../ExternalLink.astro';
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { work } = home[locale];
const t = ui[locale];
const projects = await getProjects(locale);
---

<section class="block" id="work" aria-labelledby="h-work">
  <div class="wrap">
    <SectionHead num="02" eyebrow={work.eyebrow} heading={work.heading} id="h-work" />
    <div class="cards">
      {
        projects.map((entry) => {
          const { data } = entry;
          const href = workPath(projectSlug(entry), locale);
          return (
            <article class:list={['card', { 'card--wide': data.wide }]} aria-labelledby={`card-${entry.id}`}>
              <div class="card-head">
                <span>
                  {data.kind} · {data.period}
                </span>
                <span class:list={['chip', `chip--${data.badge.tone}`]}>{data.badge.label}</span>
              </div>
              <div class="card-body">
                <div class="card-main">
                  <h3 id={`card-${entry.id}`}>
                    <a href={href}>{data.title}</a>
                  </h3>
                  <p>{data.summary}</p>
                  <ul class="tags" aria-label={t.caseStudy.stack}>
                    {data.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                </div>
                {data.wide && data.figures.length > 0 && (
                  <dl class="figs">
                    {data.figures.map((fig) => (
                      <div>
                        <dt>{fig.label}</dt>
                        <dd>{fig.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}
              </div>
              <div class="card-foot">
                <a href={href}>
                  {t.caseStudy.readMore}
                  <span class="visually-hidden">: {data.title}</span>
                  <Icon name="arrow-right" />
                </a>
                {data.links.map((link) => (
                  <ExternalLink href={link.href} locale={locale}>
                    {link.label}
                  </ExternalLink>
                ))}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .card:hover {
    border-color: var(--muted);
  }
  .card-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.7rem 1.25rem;
    border-bottom: 1px solid var(--line);
    font: 400 0.75rem/1.5 var(--mono);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .card-main {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .card p {
    margin: 0 0 1rem;
    font-size: 0.9375rem;
  }
  .card .tags {
    margin-top: auto;
  }
  .card-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
    padding: 0.8rem 1.25rem;
    border-top: 1px solid var(--line);
  }
  .card-foot :global(a) {
    font: 500 0.8125rem var(--mono);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: var(--accent);
  }
  .card-foot :global(a:hover) {
    text-decoration: underline;
  }
  .card--wide {
    grid-column: 1 / -1;
  }
  .card--wide .card-body {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 1.5rem 2.5rem;
  }
  .card--wide h3 {
    font-size: clamp(1.25rem, 2.4vw, 1.5rem);
  }
  .figs {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    align-self: start;
  }
  .figs div {
    background: var(--surface);
    padding: 0.85rem 1rem;
    min-width: 0;
  }
  .figs dt {
    font: 400 0.6875rem/1.4 var(--mono);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .figs dd {
    margin: 0.3rem 0 0;
    font: 500 1.125rem/1.2 var(--mono);
  }
  @media (max-width: 820px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .card--wide .card-body {
      grid-template-columns: 1fr;
    }
  }
</style>
