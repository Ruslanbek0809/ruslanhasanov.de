---
import { home } from '../../data';
import { workPath, type Locale } from '../../i18n/routes';
import { ui } from '../../i18n/ui';
import { getProjects, projectSlug } from '../../lib/projects';
import ExternalLink from '../ExternalLink.astro';
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { work } = home[locale];
const t = ui[locale];
const projects = await getProjects(locale);
---

<section class="block work" id="work" aria-labelledby="h-work">
  <div class="wrap">
    <SectionHead heading={work.heading} id="h-work" />
    <div class="cards">
      {
        projects.map((entry) => {
          const { data } = entry;
          const href = workPath(projectSlug(entry), locale);
          return (
            <article class:list={['card', { 'card--wide': data.wide }]} aria-labelledby={`card-${entry.id}`}>
              <p class="meta">
                {data.kind} · {data.period} · <span class:list={['chip', `chip--${data.badge.tone}`]}>{data.badge.label}</span>
              </p>
              <h3 id={`card-${entry.id}`}>
                <a href={href}>{data.title}</a>
              </h3>
              <p class="summary">{data.summary}</p>
              {data.wide && data.figures.length > 0 && (
                <dl class="figs">
                  {data.figures.map((fig) => (
                    <div>
                      <dt>{fig.label}</dt>
                      <dd>{fig.value}</dd>
                    </div>
                  ))}
                </dl>
              )}
              <ul class="tags" aria-label={t.caseStudy.stack}>
                {data.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <div class="card-foot">
                <a class="read" href={href}>
                  {t.caseStudy.readMore}
                  <span class="visually-hidden">: {data.title}</span>
                  <Icon name="arrow-right" />
                </a>
                {data.links.map((link) => (
                  <ExternalLink href={link.href} locale={locale}>
                    {link.label}
                  </ExternalLink>
                ))}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .work h2 {
    font-size: clamp(2rem, 4.6vw, 3.25rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 3.5rem) clamp(2rem, 4vw, 3.5rem);
  }
  .card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .meta {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted);
  }
  h3 {
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .summary {
    margin: 0 0 1.25rem;
  }
  .card .tags {
    margin-top: auto;
  }
  .card-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 1.25rem;
  }
  .card-foot :global(a) {
    font: 600 0.9375rem var(--sans);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--ink);
  }
  .card-foot .read {
    color: var(--accent);
  }
  .card-foot :global(a:hover) {
    text-decoration: underline;
  }

  /* The thesis: the one framed panel on the page */
  .card--wide {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    column-gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) * 1.5);
    background: var(--surface);
    padding: clamp(1.5rem, 4.5vw, 3.25rem);
  }
  .card--wide > :not(.figs) {
    grid-column: 1;
  }
  .card--wide h3 {
    font-size: clamp(1.5rem, 2.8vw, 2.125rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .card--wide .summary {
    font-size: 1.0625rem;
    max-width: 36rem;
  }
  .card--wide .tags {
    margin-top: 0;
  }
  .figs {
    grid-column: 2;
    grid-row: 1 / span 5;
    align-self: center;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, max-content);
    justify-content: start;
    gap: 1.75rem 2rem;
  }
  .figs div {
    min-width: 0;
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.3rem;
  }
  .figs dt {
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--muted);
  }
  .figs dd {
    margin: 0;
    font: 700 clamp(1.25rem, 2vw, 1.5rem)/1.1 var(--sans);
    letter-spacing: -0.03em;
    color: var(--ink);
    white-space: nowrap;
  }
  @media (max-width: 820px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .card--wide {
      grid-template-columns: 1fr;
    }
    .figs {
      grid-column: 1;
      grid-row: auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem 1rem;
      margin: 0.25rem 0 1.5rem;
      padding: 1.25rem 0;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }
    .figs dd {
      white-space: normal;
    }
  }
</style>
