---
import { home } from '../../data';
import type { Locale } from '../../i18n/routes';
import SectionHead from '../SectionHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { highlights } = home[locale];
---

<section class="block" aria-labelledby="h-highlights">
  <div class="wrap">
    <SectionHead num="01" eyebrow={highlights.eyebrow} heading={highlights.heading} id="h-highlights" />
    <ul class="tiles">
      {
        highlights.items.map((item) => (
          <li>
            <span class="idx" aria-hidden="true">{item.index}</span>
            <span class="val">{item.value}</span>
            <span class="cap">{item.caption}</span>
            {item.bars && (
              <div class="bars" aria-hidden="true">
                <div>
                  {item.bars.reference}
                  <span class="b0" />
                </div>
                <div>
                  {item.bars.model}
                  <span class="b1" style={`width: ${Math.round(item.bars.ratio * 100)}%`} />
                </div>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tiles li {
    background: var(--surface);
    padding: 1.25rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .idx {
    font: 400 0.75rem var(--mono);
    color: var(--muted);
  }
  .val {
    font: 500 clamp(2rem, 4vw, 2.75rem)/1.1 var(--mono);
    letter-spacing: -0.03em;
    margin: 1.25rem 0 0.5rem;
    white-space: nowrap;
  }
  .cap {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .bars {
    margin-top: 1rem;
    display: grid;
    gap: 0.35rem;
    font: 400 0.6875rem/1.2 var(--mono);
    color: var(--muted);
  }
  .bars span {
    display: block;
    height: 0.375rem;
    border-radius: 0 2px 2px 0;
    margin-top: 0.2rem;
  }
  .b0 {
    width: 100%;
    background: var(--bar-base);
  }
  .b1 {
    background: var(--accent);
  }
  @media (max-width: 960px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 420px) {
    .val {
      font-size: 1.75rem;
    }
    .tiles li {
      padding: 1rem;
    }
  }
</style>
