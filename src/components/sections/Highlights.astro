---
import { home } from '../../data';
import type { Locale } from '../../i18n/routes';
import SectionHead from '../SectionHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { highlights } = home[locale];
---

<section class="figures" aria-labelledby="h-highlights">
  <div class="wrap">
    <SectionHead heading={highlights.heading} id="h-highlights" hidden />
    <ul>
      {
        highlights.items.map((item) => (
          <li>
            <span class="val">{item.value}</span>
            <span class="cap">{item.caption}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .figures {
    padding-bottom: clamp(1rem, 3vw, 2rem);
  }
  ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem clamp(1.5rem, 4vw, 3rem);
    list-style: none;
    margin: 0;
    padding: clamp(1.75rem, 4vw, 2.5rem) 0 0;
    border-top: 1px solid var(--line);
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .val {
    font: 700 clamp(1.875rem, 3.6vw, 2.625rem)/1.05 var(--sans);
    letter-spacing: -0.035em;
    color: var(--ink);
    white-space: nowrap;
  }
  .cap {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--muted);
    max-width: 14rem;
  }
  @media (max-width: 860px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
