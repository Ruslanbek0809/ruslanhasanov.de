---
import { home } from '../../data';
import type { Locale } from '../../i18n/routes';
import SectionHead from '../SectionHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { skills } = home[locale];
---

<section class="block" id="skills" aria-labelledby="h-skills">
  <div class="wrap">
    <SectionHead num="06" eyebrow={skills.eyebrow} heading={skills.heading} id="h-skills" />
    <div class="skills">
      {
        skills.groups.map((group) => (
          <div>
            <h3>{group.title}</h3>
            <ul class="tags">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
      <div>
        <h3>{skills.languagesHeading}</h3>
        <dl class="langs">
          {
            skills.languages.map((l) => (
              <div>
                <dt>{l.name}</dt>
                <dd>{l.level}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    padding: 1px 0 0 1px;
  }
  .skills > div {
    background: var(--surface);
    border: 1px solid var(--line);
    margin: -1px 0 0 -1px;
    padding: 1.1rem 1.25rem 1.25rem;
    min-width: 0;
  }
  h3 {
    font: 500 0.75rem var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .langs {
    margin: 0;
    font-size: 0.875rem;
  }
  .langs div {
    display: grid;
    grid-template-columns: minmax(5.5rem, auto) minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.35rem 0;
  }
  .langs div + div {
    border-top: 1px dashed var(--line);
  }
  .langs dt {
    font-weight: 600;
  }
  .langs dd {
    margin: 0;
    color: var(--muted);
  }
</style>
