---
import { home } from '../../data';
import type { Locale } from '../../i18n/routes';
import SectionHead from '../SectionHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { skills } = home[locale];
---

<section class="block" id="skills" aria-labelledby="h-skills">
  <div class="wrap">
    <SectionHead heading={skills.heading} id="h-skills" />
    <div class="skills">
      {
        skills.groups.map((group) => (
          <div>
            <h3>{group.title}</h3>
            <ul class="tags">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
      <div>
        <h3>{skills.languagesHeading}</h3>
        <dl class="langs">
          {
            skills.languages.map((l) => (
              <div>
                <dt>{l.name}</dt>
                <dd>{l.level}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 2.25rem clamp(2rem, 4vw, 3.5rem);
  }
  .skills > div {
    min-width: 0;
  }
  h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  .skills :global(.tags) {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .langs {
    margin: 0;
    font-size: 0.9375rem;
  }
  .langs div {
    display: grid;
    grid-template-columns: minmax(5.5rem, auto) minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.2rem 0;
  }
  .langs dt {
    font-weight: 600;
    color: var(--ink);
  }
  .langs dd {
    margin: 0;
    color: var(--muted);
  }
</style>
