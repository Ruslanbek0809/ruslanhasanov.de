---
/** Inline SVG icons from the mockup. Decorative: always aria-hidden. */
interface Props {
  name: 'download' | 'external' | 'arrow-right' | 'arrow-left' | 'github' | 'linkedin' | 'award' | 'mail';
  class?: string;
}
const { name, class: className = 'i' } = Astro.props;
---

{name === 'download' && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true">
    <path d="M8 2v8m-3.5-3.5L8 10l3.5-3.5M3 13.5h10" fill="none" stroke="currentColor" stroke-width="1.5" />
  </svg>
)}
{name === 'external' && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true">
    <path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.5" />
  </svg>
)}
{name === 'arrow-right' && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true">
    <path d="M2.5 8h10M9 4.5 12.5 8 9 11.5" fill="none" stroke="currentColor" stroke-width="1.5" />
  </svg>
)}
{name === 'arrow-left' && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true">
    <path d="M13.5 8h-10M7 4.5 3.5 8 7 11.5" fill="none" stroke="currentColor" stroke-width="1.5" />
  </svg>
)}
{name === 'mail' && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true">
    <path d="M1.75 3.75h12.5v8.5H1.75zM2 4l6 4.75L14 4" fill="none" stroke="currentColor" stroke-width="1.5" />
  </svg>
)}
{name === 'github' && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true">
    <path
      fill="currentColor"
      d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.67.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"
    />
  </svg>
)}
{name === 'linkedin' && (
  <svg class={className} viewBox="0 0 16 16" aria-hidden="true">
    <path
      fill="currentColor"
      d="M13.6 0H2.4A2.4 2.4 0 0 0 0 2.4v11.2A2.4 2.4 0 0 0 2.4 16h11.2a2.4 2.4 0 0 0 2.4-2.4V2.4A2.4 2.4 0 0 0 13.6 0ZM4.9 13.3H2.6V6h2.3v7.3ZM3.7 5a1.3 1.3 0 1 1 0-2.7 1.3 1.3 0 0 1 0 2.7Zm9.7 8.3H11V9.8c0-.9 0-2-1.2-2s-1.4.9-1.4 1.9v3.6H6.1V6h2.2v1h.1c.3-.6 1.1-1.2 2.2-1.2 2.4 0 2.8 1.6 2.8 3.6v3.9Z"
    />
  </svg>
)}
{name === 'award' && (
  <svg class={className} viewBox="0 0 20 20" aria-hidden="true">
    <circle cx="10" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path d="M7 12.5 6 18l4-2 4 2-1-5.5" fill="none" stroke="currentColor" stroke-width="1.5" />
  </svg>
)}
