---
import '../styles/fonts.css';
import '../styles/global.css';
import { site } from '../config/site';
import { absoluteUrl, locales, type Alternates, type Locale } from '../i18n/routes';
import { ui } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Same page in each language. Omit for pages without a counterpart (404). */
  alternates?: Alternates;
  noindex?: boolean;
  ogType?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, unknown>;
}

const { locale, title, description, alternates, noindex = false, ogType = 'website', jsonLd } = Astro.props;
const t = ui[locale];
const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = absoluteUrl(site.ogImage);
const ogLocale = { en: 'en_US', de: 'de_DE' } as const;
const headerAlternates: Alternates = alternates ?? { en: '/', de: '/de/' };
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      alternates &&
        !noindex &&
        locales.map((l) => <link rel="alternate" hreflang={l} href={absoluteUrl(alternates[l])} />)
    }
    {alternates && !noindex && <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates.en)} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f9fafb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#06070a" media="(prefers-color-scheme: dark)" />
    <meta name="author" content={site.name} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {alternates && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={ogLocale[locale]} />
    {alternates && <meta property="og:locale:alternate" content={ogLocale[locale === 'en' ? 'de' : 'en']} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">{t.skipLink}</a>
    <Header locale={locale} alternates={headerAlternates} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
